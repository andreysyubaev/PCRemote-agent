<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PCRemote.Desktop.App"
             xmlns:local="using:PCRemote.Desktop"
             RequestedThemeVariant="Light">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <!-- Light Theme -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackground" Color="#F5F6F8"/>
                    <SolidColorBrush x:Key="SurfaceBackground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="PrimaryText" Color="#20242B"/>
                    <SolidColorBrush x:Key="SecondaryText" Color="#737B87"/>
                    <SolidColorBrush x:Key="Accent" Color="#5865F2"/>
                    <SolidColorBrush x:Key="Success" Color="#249B68"/>
                    <SolidColorBrush x:Key="Danger" Color="#D94B4B"/>
                    <SolidColorBrush x:Key="Border" Color="#E6E8ED"/>
                </ResourceDictionary>

                <!-- Dark Theme -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackground" Color="#171A21"/>
                    <SolidColorBrush x:Key="SurfaceBackground" Color="#222630"/>
                    <SolidColorBrush x:Key="PrimaryText" Color="#F0F2F5"/>
                    <SolidColorBrush x:Key="SecondaryText" Color="#A0A8B5"/>
                    <SolidColorBrush x:Key="Accent" Color="#5865F2"/>
                    <SolidColorBrush x:Key="Success" Color="#35B982"/>
                    <SolidColorBrush x:Key="Danger" Color="#F06B6B"/>
                    <SolidColorBrush x:Key="Border" Color="#343A46"/>
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://PCRemote.Desktop/Styles/Styles.axaml" />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/avalonia-logo.ico"
                      ToolTipText="PCRemote">

                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="PCRemote"
                                        IsEnabled="False" />

                        <NativeMenuItemSeparator />

                        <NativeMenuItem Header="Open PCRemote"
                                        Click="OpenPCRemote_Click"/>

                        <NativeMenuItem Header="Start Agent"
                                        Click="StartAgent_Click"/>

                        <NativeMenuItem Header="Stop Agent"
                                        Click="StopAgent_Click"/>

                        <NativeMenuItemSeparator />

                        <NativeMenuItem Header="Exit"
                                        Click="Exit_Click" />
                    </NativeMenu>
                </TrayIcon.Menu>

            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>