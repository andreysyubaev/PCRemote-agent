<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PCRemote.Desktop.App"
             xmlns:local="using:PCRemote.Desktop"
             xmlns:loc="using:PCRemote.Desktop.Localization"
             RequestedThemeVariant="Light">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PCRemote.Desktop/Themes/Colors.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <FontFamily x:Key="Inter">
                avares://PCRemote.Desktop/Assets/Fonts#Inter
            </FontFamily>
        </ResourceDictionary>
    </Application.Resources>
    
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="TextElement.FontFamily"
                    Value="{DynamicResource Inter}"/>
        </Style>

        <StyleInclude Source="avares://PCRemote.Desktop/Styles/Styles.axaml"/>
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/Icons/App/tray-agent-off.png"
                      ToolTipText="PCRemote">

                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{loc:Loc Key=App_Name}"
                                        IsEnabled="False" />

                        <NativeMenuItemSeparator />

                        <NativeMenuItem Header="{loc:Loc Key=Tray_Open}"
                                        Click="OpenPCRemote_Click"/>

                        <NativeMenuItem Header="{loc:Loc Key=Tray_StartAgent}"
                                        Click="StartAgent_Click"/>

                        <NativeMenuItem Header="{loc:Loc Key=Tray_StopAgent}"
                                        Click="StopAgent_Click"/>

                        <NativeMenuItemSeparator />

                        <NativeMenuItem Header="{loc:Loc Key=Tray_Exit}"
                                        Click="Exit_Click" />
                    </NativeMenu>
                </TrayIcon.Menu>

            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>