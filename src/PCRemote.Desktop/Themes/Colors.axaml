<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- Light Theme -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackground" Color="#F6F6F7"/>
            <SolidColorBrush x:Key="SurfaceBackground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SurfaceElevatedBackground" Color="#ECEDEF"/>
            <SolidColorBrush x:Key="PrimaryText" Color="#191B20"/>
            <SolidColorBrush x:Key="PrimaryInverseText" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="SecondaryText" Color="#A3191B20"/>
            <SolidColorBrush x:Key="MutedText" Color="#68707C"/>
            <SolidColorBrush x:Key="ButtonText" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="ButtonTextDisabled" Color="#64F5F5F5"/>
            <SolidColorBrush x:Key="Accent" Color="#FF4401"/>
            <SolidColorBrush x:Key="AccentHover" Color="#FF6A35"/>
            <SolidColorBrush x:Key="AccentPressed" Color="#D93600"/>
            <SolidColorBrush x:Key="AccentSubtle" Color="#14FF4401"/>
            <SolidColorBrush x:Key="AccentDisabled" Color="#32FF4401"/>
            <SolidColorBrush x:Key="Success" Color="#16803C"/>
            <SolidColorBrush x:Key="Danger" Color="#C6283D"/>
            <SolidColorBrush x:Key="Info" Color="#2459B8"/>
            <SolidColorBrush x:Key="Neutral" Color="#626B78"/>
            <SolidColorBrush x:Key="Debug" Color="#7046C8"/>
            <SolidColorBrush x:Key="Warning" Color="#946200"/>
            <SolidColorBrush x:Key="Fatal" Color="#C93600"/>
            <SolidColorBrush x:Key="Border" Color="#D9DCE1"/>
            <SolidColorBrush x:Key="ItemHoverBackground" Color="#14000000"/>
            <SolidColorBrush x:Key="InputHoverBackground" Color="#E3E4E5"/>
            <SolidColorBrush x:Key="InputPressedBackground" Color="#D9DADC"/>

            <x:String x:Key="AppLogoIcon">/Assets/Icons/desktop-outline.svg</x:String>
            <x:String x:Key="SvgIconCss">path, circle { fill: #191B20 !important; }</x:String>
            <x:String x:Key="SvgAccentCss">path, circle { fill: #FF4401 !important; }</x:String>
            <x:String x:Key="SvgMutedCss">path, circle { fill: #68707C !important; }</x:String>
            <x:String x:Key="SvgSuccessCss">path, circle { fill: #16803C !important; }</x:String>
            <x:String x:Key="SvgDangerCss">path, circle { fill: #C6283D !important; }</x:String>
            <x:String x:Key="SvgInfoCss">path, circle { fill: #2459B8 !important; }</x:String>
            <x:String x:Key="SvgNeutralCss">path, circle { fill: #626B78 !important; }</x:String>
            <x:String x:Key="SvgDebugCss">path, circle { fill: #7046C8 !important; }</x:String>
            <x:String x:Key="SvgWarningCss">path, circle { fill: #946200 !important; }</x:String>
            <x:String x:Key="SvgFatalCss">path, circle { fill: #C93600 !important; }</x:String>
        </ResourceDictionary>

        <!-- Dark Theme -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackground" Color="#111214"/>
            <SolidColorBrush x:Key="SurfaceBackground" Color="#1B1D21"/>
            <SolidColorBrush x:Key="SurfaceElevatedBackground" Color="#25282D"/>
            <SolidColorBrush x:Key="PrimaryText" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="PrimaryInverseText" Color="#191B20"/>
            <SolidColorBrush x:Key="SecondaryText" Color="#9CFFFFFF"/>
            <SolidColorBrush x:Key="MutedText" Color="#92969F"/>
            <SolidColorBrush x:Key="ButtonText" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="ButtonTextDisabled" Color="#64F5F5F5"/>
            <SolidColorBrush x:Key="Accent" Color="#FF4401"/>
            <SolidColorBrush x:Key="AccentHover" Color="#A92D00"/>
            <SolidColorBrush x:Key="AccentPressed" Color="#862400"/>
            <SolidColorBrush x:Key="AccentSubtle" Color="#14FF4401"/>
            <SolidColorBrush x:Key="AccentDisabled" Color="#32FF4401"/>
            <SolidColorBrush x:Key="Success" Color="#42DE80"/>
            <SolidColorBrush x:Key="Danger" Color="#FB7185"/>
            <SolidColorBrush x:Key="Info" Color="#60A5F2"/>
            <SolidColorBrush x:Key="Neutral" Color="#A1A1AA"/>
            <SolidColorBrush x:Key="Debug" Color="#A78BFA"/>
            <SolidColorBrush x:Key="Warning" Color="#FBBF24"/>
            <SolidColorBrush x:Key="Fatal" Color="#FF4401"/>
            <SolidColorBrush x:Key="Border" Color="#383B42"/>
            <SolidColorBrush x:Key="ItemHoverBackground" Color="#14FFFFFF"/>
            <SolidColorBrush x:Key="InputHoverBackground" Color="#2E3135"/>
            <SolidColorBrush x:Key="InputPressedBackground" Color="#36393D"/>

            <x:String x:Key="AppLogoIcon">/Assets/Icons/desktop.svg</x:String>
            <x:String x:Key="SvgIconCss">path, circle { fill: #F5F5F5 !important; }</x:String>
            <x:String x:Key="SvgAccentCss">path, circle { fill: #FF4401 !important; }</x:String>
            <x:String x:Key="SvgMutedCss">path, circle { fill: #92969F !important; }</x:String>
            <x:String x:Key="SvgSuccessCss">path, circle { fill: #42DE80 !important; }</x:String>
            <x:String x:Key="SvgDangerCss">path, circle { fill: #FB7185 !important; }</x:String>
            <x:String x:Key="SvgInfoCss">path, circle { fill: #60A5F2 !important; }</x:String>
            <x:String x:Key="SvgNeutralCss">path, circle { fill: #A1A1AA !important; }</x:String>
            <x:String x:Key="SvgDebugCss">path, circle { fill: #A78BFA !important; }</x:String>
            <x:String x:Key="SvgWarningCss">path, circle { fill: #FBBF24 !important; }</x:String>
            <x:String x:Key="SvgFatalCss">path, circle { fill: #FF4401 !important; }</x:String>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <x:String x:Key="SvgInverseCss">path, circle { fill: #F5F5F5 !important; }</x:String>
    
</ResourceDictionary>
