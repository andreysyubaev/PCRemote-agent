
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PCRemote.Desktop.ViewModels.Pages"
             xmlns:loc="using:PCRemote.Desktop.Localization"
             x:Class="PCRemote.Desktop.Views.Pages.AboutPage"
             x:DataType="vm:AboutPageViewModel">

    <StackPanel Spacing="20">

        <StackPanel Spacing="4">
            <TextBlock Text="{loc:Loc Key=About_Title}"
                       FontSize="28"
                       FontWeight="Bold"/>

            <TextBlock Text="{loc:Loc Key=About_Description}"
                       Foreground="{DynamicResource SecondaryText}"/>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock Text="PCRemote"
                       FontSize="24"
                       FontWeight="Bold"/>

            <TextBlock Text="{loc:Loc Key=About_ProjectDescription}"
                       FontSize="14"
                       Foreground="{DynamicResource SecondaryText}"/>
        </StackPanel>

        <Border Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">

            <StackPanel Spacing="16">

                <TextBlock Text="{loc:Loc Key=About_Project}"
                           FontSize="16"
                           FontWeight="SemiBold"/>

                <Button Content="{loc:Loc Key=About_GitHub}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="OnGitHubClick"/>

                <TextBlock Text="{loc:Loc Key=About_Contact}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"/>

                <Button Content="Telegram"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="OnTelegramClick"/>

            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
