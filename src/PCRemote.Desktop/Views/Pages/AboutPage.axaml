<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PCRemote.Desktop.ViewModels.Pages"
             xmlns:loc="using:PCRemote.Desktop.Localization"
             x:Class="PCRemote.Desktop.Views.Pages.AboutPage"
             x:DataType="vm:AboutPageViewModel"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Application logo -->
            <Border Width="56"
                    Height="56"
                    Margin="0,10,0,0"
                    CornerRadius="8"
                    Background="{DynamicResource Accent}"
                    HorizontalAlignment="Center">
                <Svg Path="/Assets/Icons/desktop.svg"
                     Classes="inverse"
                     Width="24"
                     Height="24"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
            </Border>

            <TextBlock Classes="heading-section"
                       Text="PCRemote"
                       HorizontalAlignment="Center"
                       Margin="0,16,0,0"/>

            <TextBlock Classes="body-small"
                       Text="{loc:Loc Key=About_Tagline}"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>

            <TextBlock Classes="caption-xs"
                       Text="{loc:Loc Key=About_Version}"
                       LineHeight="16"
                       Foreground="{DynamicResource Success}"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>

            <!-- About the application -->
            <Border Classes="card"
                    Margin="0,16,0,0">
                <StackPanel Spacing="16">
                    <TextBlock Classes="heading-section"
                               Text="{loc:Loc Key=About_Application}"/>

                    <TextBlock Classes="body-small"
                               LineHeight="20"
                               TextWrapping="Wrap"
                               Text="{loc:Loc Key=About_ApplicationDescription}"/>
                </StackPanel>
            </Border>

            <!-- Links -->
            <TextBlock Classes="heading-section"
                       Text="{loc:Loc Key=About_Links}"
                       Margin="0,32,0,0"/>

            <StackPanel Spacing="16"
                        Margin="0,24,0,0">

                <!-- GitHub -->
                <Grid ColumnDefinitions="Auto,*,Auto"
                      Height="44">
                    <Svg Path="/Assets/Icons/github.svg"
                         Width="20"
                         Height="20"
                         VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                Spacing="8"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Classes="label"
                                   Text="{loc:Loc Key=About_GitHub}"/>
                        <TextBlock Classes="body-small"
                                   Text="{Binding RepositoryUrl}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="16"
                                VerticalAlignment="Center">
                        <Button Classes="icon"
                                Width="36"
                                Height="36"
                                Click="OnCopyRepositoryClick"
                                ToolTip.Tip="{loc:Loc Key=About_CopyLink}">
                            <Panel x:Name="RepositoryCopyFeedback"
                                   Classes="copy-feedback"
                                   Width="20"
                                   Height="20">
                                <Svg Classes="copy-idle"
                                     Path="/Assets/Icons/copy-outline.svg"
                                     Width="20"
                                     Height="20"/>
                                <Svg Classes="copy-success"
                                     Path="/Assets/Icons/checkmark.svg"
                                     Width="20"
                                     Height="20"/>
                            </Panel>
                        </Button>

                        <Button Classes="icon"
                                Width="36"
                                Height="36"
                                Click="OnGitHubClick"
                                ToolTip.Tip="{loc:Loc Key=About_OpenLink}">
                            <Svg Path="/Assets/Icons/external-link-outline.svg"
                                 Width="20"
                                 Height="20"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Telegram -->
                <Grid ColumnDefinitions="Auto,*,Auto"
                      Height="44">
                    <Svg Path="/Assets/Icons/telegram.svg"
                         Width="20"
                         Height="20"
                         VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                Spacing="8"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Classes="label"
                                   Text="{loc:Loc Key=About_Telegram}"/>
                        <TextBlock Classes="body-small"
                                   Text="{Binding TelegramUrl}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="16"
                                VerticalAlignment="Center">
                        <Button Classes="icon"
                                Width="36"
                                Height="36"
                                Click="OnCopyTelegramClick"
                                ToolTip.Tip="{loc:Loc Key=About_CopyLink}">
                            <Panel x:Name="TelegramCopyFeedback"
                                   Classes="copy-feedback"
                                   Width="20"
                                   Height="20">
                                <Svg Classes="copy-idle"
                                     Path="/Assets/Icons/copy-outline.svg"
                                     Width="20"
                                     Height="20"/>
                                <Svg Classes="copy-success"
                                     Path="/Assets/Icons/checkmark.svg"
                                     Width="20"
                                     Height="20"/>
                            </Panel>
                        </Button>

                        <Button Classes="icon"
                                Width="36"
                                Height="36"
                                Click="OnTelegramClick"
                                ToolTip.Tip="{loc:Loc Key=About_OpenLink}">
                            <Svg Path="/Assets/Icons/external-link-outline.svg"
                                 Width="20"
                                 Height="20"/>
                        </Button>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
