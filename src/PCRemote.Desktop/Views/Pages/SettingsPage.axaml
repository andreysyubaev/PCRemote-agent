<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PCRemote.Desktop.ViewModels.Pages"
             xmlns:loc="using:PCRemote.Desktop.Localization"
             x:Class="PCRemote.Desktop.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsPageViewModel"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">

            <!-- Appearance -->
            <Border Classes="card">
                <StackPanel Classes="card-content">
                    <TextBlock Classes="heading-section"
                               Text="{loc:Loc Key=Settings_Appearance}"/>

                    <StackPanel Spacing="16">
                        <!-- Theme -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Height="44">
                            <Svg Path="/Assets/Icons/color-palette-outline.svg"
                                 Width="20" Height="20"
                                 VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1"
                                        Spacing="8"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Classes="label"
                                           Text="{loc:Loc Key=Settings_Theme}"/>
                                <TextBlock Classes="body-small"
                                           Text="{loc:Loc Key=Settings_ThemeDescription}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <ComboBox Grid.Column="2"
                                      Classes="settings"
                                      Width="140"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding ThemeOptions}"
                                      SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}"/>
                        </Grid>

                        <!-- Language -->
                        <Grid ColumnDefinitions="Auto,*,Auto" Height="44">
                            <Svg Path="/Assets/Icons/globe-outline.svg"
                                 Width="20" Height="20"
                                 VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1"
                                        Spacing="8"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Classes="label"
                                           Text="{loc:Loc Key=Settings_Language}"/>
                                <TextBlock Classes="body-small"
                                           Text="{loc:Loc Key=Settings_LanguageDescription}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Button Classes="icon"
                                        Width="32" Height="32"
                                        Command="{Binding RestartApplicationCommand}"
                                        IsVisible="{Binding IsLanguageChangePending}"
                                        ToolTip.Tip="{loc:Loc Key=Settings_RestartApplication}">
                                    <Svg Path="/Assets/Icons/refresh.svg"
                                         Width="20" Height="20"/>
                                </Button>

                                <ComboBox Classes="settings"
                                          Width="140"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding LanguageOptions}"
                                          SelectedIndex="{Binding SelectedLanguageIndex, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Telegram -->
            <Border Classes="card">
                <StackPanel Classes="card-content">
                    <TextBlock Classes="heading-section"
                               Text="{loc:Loc Key=Settings_Telegram}"/>

                    <!-- Pairing code -->
                    <StackPanel Spacing="16"
                                IsVisible="{Binding IsPairingBlockVisible}">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="label"
                                       Text="{loc:Loc Key=Settings_PairTelegram}"/>
                            <TextBlock Classes="body-small"
                                       Text="{loc:Loc Key=Settings_PairTelegramDescription}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="16"
                                    VerticalAlignment="Center">
                            <TextBlock Classes="pairing-value"
                                       Text="{Binding PairingCodeText}"/>

                            <Button Classes="icon"
                                    Width="36" Height="36"
                                    Click="OnCopyPairingCodeClick"
                                    IsEnabled="{Binding HasPairingCode}"
                                    ToolTip.Tip="{loc:Loc Key=Common_Copy}">
                                <Panel Width="20" Height="20">
                                    <Svg x:Name="CopyIcon"
                                         Path="/Assets/Icons/copy-outline.svg"
                                         Width="20" Height="20"/>

                                    <Svg x:Name="CopySuccessIcon"
                                         Path="/Assets/Icons/checkmark.svg"
                                         Width="20" Height="20"
                                         IsVisible="False"/>
                                </Panel>
                            </Button>
                        </StackPanel>

                        <TextBlock Classes="body-small"
                                   Text="{Binding PairingExpiryText}"
                                   IsVisible="{Binding HasPairingCode}"/>

                        <TextBlock Classes="body-small"
                                   Text="{loc:Loc Key=Settings_PairingCodeUnavailable}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding !HasPairingCode}"/>
                    </StackPanel>

                    <!-- Disconnect / confirmation -->
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          Height="44"
                          IsVisible="{Binding IsDisconnectBlockVisible}">
                        <Svg Path="/Assets/Icons/telegram.svg"
                             Width="20" Height="20"
                             VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    Spacing="8"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Classes="label"
                                       Text="{Binding TelegramActionTitle}"/>
                            <TextBlock Classes="body-small"
                                       Text="{Binding TelegramActionDescription}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="16"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding !IsDisconnectConfirmationVisible}">
                            <Button Classes="primary"
                                    Content="{loc:Loc Key=Common_Disconnect}"
                                    Command="{Binding ShowDisconnectConfirmationCommand}"
                                    IsEnabled="{Binding !IsBusy}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="16"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsDisconnectConfirmationVisible}">
                            <Button Classes="confirm secondary"
                                    Command="{Binding CancelDisconnectCommand}"
                                    IsEnabled="{Binding !IsBusy}"
                                    ToolTip.Tip="{loc:Loc Key=Common_Cancel}">
                                <Svg Path="/Assets/Icons/close.svg"
                                     Width="20" Height="20"/>
                            </Button>

                            <Button Classes="confirm primary"
                                    Command="{Binding ConfirmDisconnectCommand}"
                                    IsEnabled="{Binding !IsBusy}"
                                    ToolTip.Tip="{loc:Loc Key=Common_Disconnect}">
                                <Svg Classes="inverse"
                                     Path="/Assets/Icons/checkmark.svg"
                                     Width="20" Height="20"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock Classes="body-small"
                               Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasStatusMessage}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
