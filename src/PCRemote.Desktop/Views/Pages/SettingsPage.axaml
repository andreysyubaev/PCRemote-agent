
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PCRemote.Desktop.ViewModels.Pages"
             xmlns:loc="using:PCRemote.Desktop.Localization"
             x:Class="PCRemote.Desktop.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsPageViewModel">

    <ScrollViewer>
        <StackPanel Spacing="20">

            <TextBlock Text="{loc:Loc Key=Settings_Title}"
                       FontSize="28"
                       FontWeight="Bold"/>

            <!-- Appearance -->
            <Border Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">

                <StackPanel Spacing="16">

                    <TextBlock Text="{loc:Loc Key=Settings_Appearance}"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <Grid ColumnDefinitions="*,Auto">

                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Loc Key=Settings_Theme}"
                                       FontWeight="Medium"/>

                            <TextBlock Text="{loc:Loc Key=Settings_ThemeDescription}"
                                       Foreground="{DynamicResource SecondaryText}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ThemeOptions}"
                                  SelectedIndex="{Binding SelectedThemeIndex}"
                                  VerticalAlignment="Center"
                                  MinWidth="130"/>

                    </Grid>
                    
                    <!-- Language -->
                    <Grid ColumnDefinitions="*,Auto">

                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Loc Key=Settings_Language}"
                                       FontWeight="Medium"/>

                            <TextBlock Text="{loc:Loc Key=Settings_LanguageDescription}"
                                       Foreground="{DynamicResource SecondaryText}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding LanguageOptions}"
                                  SelectedIndex="{Binding SelectedLanguageIndex}"
                                  VerticalAlignment="Center"
                                  MinWidth="130"/>

                    </Grid>

                    <!-- Language restart notification -->
                    <Border Background="{DynamicResource AppBackground}"
                            CornerRadius="8"
                            Padding="16"
                            IsVisible="{Binding IsLanguageChangePending}">

                        <StackPanel Spacing="12">

                            <TextBlock Text="{loc:Loc Key=Settings_LanguageRestartTitle}"
                                       FontWeight="SemiBold"
                                       FontSize="16"/>

                            <TextBlock Text="{loc:Loc Key=Settings_LanguageRestartDescription}"
                                       Foreground="{DynamicResource SecondaryText}"
                                       TextWrapping="Wrap"/>

                            <Button Content="{loc:Loc Key=Settings_RestartApplication}"
                                    Command="{Binding RestartApplicationCommand}"
                                    HorizontalAlignment="Left"/>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!-- Application startup -->
            <Border Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">

                <StackPanel Spacing="16">

                    <TextBlock Text="{loc:Loc Key=Settings_Startup}"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <Grid ColumnDefinitions="*,Auto">

                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Loc Key=Settings_AutoStart}"
                                       FontWeight="Medium"/>

                            <TextBlock Text="{loc:Loc Key=Settings_AutoStartDescription}"
                                       Foreground="{DynamicResource SecondaryText}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding IsAutoStartEnabled}"
                                      VerticalAlignment="Center"/>

                    </Grid>

                    <TextBlock Text="{Binding AutoStartStatusMessage}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryText}"/>

                </StackPanel>
            </Border>

            <!-- Telegram -->
            <Border Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">

                <StackPanel Spacing="16">

                    <TextBlock Text="{loc:Loc Key=Settings_Telegram}"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{loc:Loc Key=Settings_DisconnectDescription}"
                               Foreground="{DynamicResource SecondaryText}"
                               TextWrapping="Wrap"/>

                    <Button Content="{loc:Loc Key=Settings_DisconnectBot}"
                            Command="{Binding ShowDisconnectConfirmationCommand}"
                            HorizontalAlignment="Left"
                            IsEnabled="{Binding !IsBusy}"/>

                    <!-- Confirmation -->
                    <Border Background="{DynamicResource AppBackground}"
                            CornerRadius="8"
                            Padding="16"
                            IsVisible="{Binding IsDisconnectConfirmationVisible}">

                        <StackPanel Spacing="12">

                            <TextBlock Text="{loc:Loc Key=Settings_ConfirmTitle}"
                                       FontWeight="SemiBold"
                                       FontSize="16"/>

                            <TextBlock Text="{loc:Loc Key=Settings_ConfirmDescription}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryText}"/>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10">

                                <Button Content="{loc:Loc Key=Common_Cancel}"
                                        Command="{Binding CancelDisconnectCommand}"
                                        IsEnabled="{Binding !IsBusy}"/>

                                <Button Content="{loc:Loc Key=Common_Disconnect}"
                                        Command="{Binding ConfirmDisconnectCommand}"
                                        IsEnabled="{Binding !IsBusy}"/>

                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryText}"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
