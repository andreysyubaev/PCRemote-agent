<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PCRemote.Desktop.ViewModels.Pages"
             x:Class="PCRemote.Desktop.Views.Pages.HomePage"
             x:DataType="vm:HomePageViewModel">

    <ScrollViewer>
        <StackPanel Spacing="20">

            <TextBlock Text="Dashboard"
                       FontSize="28"
                       FontWeight="Bold"/>

            <Border Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">

                <StackPanel Spacing="12">

                    <TextBlock Text="Agent status"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding AgentStatus.IsRunning,
                                               StringFormat='Running: {0}'}"/>

                    <TextBlock Text="{Binding AgentStatus.IsTelegramConnected,
                                               StringFormat='Telegram connected: {0}'}"/>

                    <TextBlock Text="{Binding AgentStatus.IsPaired,
                                               StringFormat='Account paired: {0}'}"/>

                    <StackPanel Orientation="Horizontal" Spacing="10">

                        <Button Content="Start Agent"
                                Command="{Binding StartAgentCommand}"
                                IsEnabled="{Binding CanStartAgent}"/>

                        <Button Content="Stop Agent"
                                Command="{Binding StopAgentCommand}"
                                IsEnabled="{Binding CanStopAgent}"/>

                    </StackPanel>

                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">

                <StackPanel Spacing="12">

                    <TextBlock Text="Telegram pairing"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding AgentStatus.PairingCode}"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding RemainingPairingTime,
                                               StringFormat='Expires in: {0}'}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Open your Telegram bot and send /pair followed by the code."
                               TextWrapping="Wrap"/>

                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryText}"/>

        </StackPanel>
    </ScrollViewer>

</UserControl>
