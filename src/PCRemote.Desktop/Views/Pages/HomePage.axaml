
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PCRemote.Desktop.ViewModels.Pages"
             xmlns:loc="using:PCRemote.Desktop.Localization"
             x:Class="PCRemote.Desktop.Views.Pages.HomePage"
             x:DataType="vm:HomePageViewModel">

    <ScrollViewer>
        <StackPanel Spacing="20">

            <TextBlock Text="{loc:Loc Key=Home_Title}"
                       FontSize="28"
                       FontWeight="Bold"/>

            <Border Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">

                <StackPanel Spacing="12">

                    <TextBlock Text="{loc:Loc Key=Home_AgentStatus}"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding RunningStatusText}"/>

                    <TextBlock Text="{Binding TelegramConnectedText}"/>

                    <TextBlock Text="{Binding AccountPairedText}"/>

                    <StackPanel Orientation="Horizontal" Spacing="10">

                        <Button Content="{loc:Loc Key=Home_StartAgent}"
                                Command="{Binding StartAgentCommand}"
                                IsEnabled="{Binding CanStartAgent}"/>

                        <Button Content="{loc:Loc Key=Home_StopAgent}"
                                Command="{Binding StopAgentCommand}"
                                IsEnabled="{Binding CanStopAgent}"/>

                    </StackPanel>

                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    IsVisible="{Binding IsPairingRequired}">

                <StackPanel Spacing="12">

                    <TextBlock Text="{loc:Loc Key=Home_TelegramPairing}"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="12">

                        <TextBlock Text="{Binding AgentStatus.PairingCode}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <Button Content="{loc:Loc Key=Common_Copy}"
                                VerticalAlignment="Center"
                                Click="OnCopyPairingCodeClick"/>

                    </StackPanel>

                    <TextBlock Text="{Binding RemainingPairingTime,
                                               StringFormat={loc:Loc Key=Home_PairingExpiresIn}}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{loc:Loc Key=Home_PairingInstructions}"
                               TextWrapping="Wrap"/>

                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryText}"/>

        </StackPanel>
    </ScrollViewer>

</UserControl>
