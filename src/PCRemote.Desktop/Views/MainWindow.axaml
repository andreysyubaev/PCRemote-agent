<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PCRemote.Desktop.ViewModels"
        xmlns:pages="using:PCRemote.Desktop.Views.Pages"
        xmlns:pagesVm="using:PCRemote.Desktop.ViewModels.Pages"
        x:Class="PCRemote.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="PCRemote"
        Width="1000"
        Height="650"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}">

    <Window.DataTemplates>
        <DataTemplate DataType="pagesVm:HomePageViewModel">
            <pages:HomePage/>
        </DataTemplate>

        <DataTemplate DataType="pagesVm:SettingsPageViewModel">
            <pages:SettingsPage/>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid ColumnDefinitions="220,*">

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,1,0"
                Padding="16">

            <StackPanel Spacing="12">

                <TextBlock Text="PCRemote"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="4,8,4,24"/>

                <Button Content="Home"
                        Command="{Binding NavigateHomeCommand}"
                        HorizontalAlignment="Stretch"/>

                <Button Content="Settings"
                        Command="{Binding NavigateSettingsCommand}"
                        HorizontalAlignment="Stretch"/>

            </StackPanel>
        </Border>

        <!-- Page content -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentPage}"
                        Margin="24"/>

    </Grid>
</Window>