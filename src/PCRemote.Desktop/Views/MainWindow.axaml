<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PCRemote.Desktop.ViewModels"
        xmlns:pages="using:PCRemote.Desktop.Views.Pages"
        xmlns:pagesVm="using:PCRemote.Desktop.ViewModels.Pages"
        xmlns:loc="using:PCRemote.Desktop.Localization"
        x:Class="PCRemote.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="PCRemote"
        Icon="/Assets/Icons/App/app-icon.ico"
        Width="670"
        Height="530"
        MinWidth="670"
        MinHeight="530"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}">

    <Window.DataTemplates>
        <DataTemplate DataType="pagesVm:HomePageViewModel">
            <pages:HomePage />
        </DataTemplate>

        <DataTemplate DataType="pagesVm:SettingsPageViewModel">
            <pages:SettingsPage />
        </DataTemplate>

        <DataTemplate DataType="pagesVm:LogsPageViewModel">
            <pages:LogsPage />
        </DataTemplate>

        <DataTemplate DataType="pagesVm:AboutPageViewModel">
            <pages:AboutPage />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid ColumnDefinitions="57,*">

        <!-- Sidebar -->
        <Border Grid.Column="0" Classes="sidebar">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Spacing="16">
                    <!-- Logo -->
                    <Svg Path="{DynamicResource AppLogoIcon}"
                         Width="25" Height="25"
                         HorizontalAlignment="Center"
                         Margin="0,0,0,8" />

                    <!-- Nav buttons -->
                    <Button Classes="nav"
                            Classes.active="{Binding IsHomeSelected}"
                            Command="{Binding NavigateHomeCommand}"
                            ToolTip.Tip="{loc:Loc Key=Navigation_Home}">
                        <Svg Path="/Assets/Icons/home-outline.svg"
                             Width="20" Height="20" />
                    </Button>

                    <Button Classes="nav"
                            Classes.active="{Binding IsSettingsSelected}"
                            Command="{Binding NavigateSettingsCommand}"
                            ToolTip.Tip="{loc:Loc Key=Navigation_Settings}">
                        <Svg Path="/Assets/Icons/settings-outline.svg"
                             Width="20" Height="20" />
                    </Button>

                    <Button Classes="nav"
                            Classes.active="{Binding IsLogsSelected}"
                            Command="{Binding NavigateLogsCommand}"
                            ToolTip.Tip="{loc:Loc Key=Navigation_Logs}">
                        <Svg Path="/Assets/Icons/file-text-outline.svg"
                             Width="20" Height="20" />
                    </Button>
                </StackPanel>

                <!-- Bottom info button -->
                <Button Grid.Row="2"
                        Classes="nav"
                        Classes.active="{Binding IsAboutSelected}"
                        Command="{Binding NavigateAboutCommand}"
                        ToolTip.Tip="{loc:Loc Key=Navigation_About}">
                    <Svg Path="/Assets/Icons/info-outline.svg"
                         Width="20" Height="20" />
                </Button>
            </Grid>
        </Border>

        <!-- Page content -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentPage}"
                        Margin="16"/>

    </Grid>
</Window>