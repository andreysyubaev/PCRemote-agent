<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PCRemote.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="450"
        x:Class="PCRemote.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="PCRemote">

    <Grid Margin="30"
          RowDefinitions="Auto,Auto,Auto,Auto,*"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Width="400">

        <TextBlock Text="PCRemote"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="1"
                   Text="Connect your Telegram bot"
                   FontSize="16"
                   Margin="0,12,0,24"
                   HorizontalAlignment="Center"/>

        <TextBox Grid.Row="2"
                 Text="{Binding BotToken}"
                 PlaceholderText="Enter Telegram bot token"
                 PasswordChar="●"/>

        <Button Grid.Row="3"
                Content="Connect"
                Command="{Binding ConnectTelegramCommand}"
                IsEnabled="{Binding !IsBusy}"
                Margin="0,12,0,0"
                HorizontalAlignment="Stretch"/>

        <StackPanel Grid.Row="4"
                    Spacing="12"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center">

            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="{Binding AgentStatus.BotUsername,
                              StringFormat='Bot: @{0}'}"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="{Binding AgentStatus.IsRunning,
                              StringFormat='Agent running: {0}'}"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="{Binding AgentStatus.IsTelegramConnected,
                              StringFormat='Telegram connected: {0}'}"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="{Binding AgentStatus.PairingCode,
                              StringFormat='Pairing code: {0}'}"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

        </StackPanel>
    </Grid>
</Window>