<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PCRemote.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="450"
        x:Class="PCRemote.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="PCRemote">

    
    <Grid>
        <StackPanel IsVisible="{Binding IsSetupRequired}"
                    Spacing="14"
                    Width="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="PCRemote"
                       FontSize="30"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Connect your Telegram bot"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <TextBox Text="{Binding BotToken}"
                     PlaceholderText="Enter Telegram bot token"
                     PasswordChar="●"/>

            <Button Content="Connect"
                    Command="{Binding ConnectTelegramCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    HorizontalAlignment="Stretch"/>

            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel IsVisible="{Binding !IsSetupRequired}"
                    Spacing="16"
                    Width="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="PCRemote"
                       FontSize="30"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Computer agent"
                       FontSize="16"
                       HorizontalAlignment="Center"/>

            <Separator/>

            <TextBlock Text="{Binding AgentStatus.BotUsername,
                                      StringFormat='Telegram bot: @{0}'}"/>

            <TextBlock Text="{Binding AgentStatus.IsRunning,
                                      StringFormat='Agent running: {0}'}"/>

            <TextBlock Text="{Binding AgentStatus.IsTelegramConnected,
                                      StringFormat='Telegram connected: {0}'}"/>
            
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        HorizontalAlignment="Center">
                <Button Content="Start Agent"
                        Command="{Binding StartAgentCommand}"
                        IsEnabled="{Binding !IsBusy}"/>

                <Button Content="Stop Agent"
                        Command="{Binding StopAgentCommand}"
                        IsEnabled="{Binding !IsBusy}"/>
            </StackPanel>

            <Separator/>

            <TextBlock Text="Pairing code"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="{Binding AgentStatus.PairingCode}"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>
        </StackPanel>
        
        
    </Grid>

</Window>