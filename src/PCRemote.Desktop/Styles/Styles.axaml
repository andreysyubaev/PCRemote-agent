<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <ThemeVariantScope RequestedThemeVariant="Dark">
        <Border Padding="24" CornerRadius="16" Width="670" Background="{DynamicResource AppBackground}">
            <Grid ColumnDefinitions="Auto,*">

                <Grid Column="0" RowDefinitions="*,Auto">
                    <Grid Grid.Row="0" RowDefinitions="*,*" RowSpacing="16">
                        <StackPanel Grid.Row="0"
                                    Spacing="16">
                            <Svg Path="/Assets/Icons/desktop-outline.svg"
                                 Width="24"
                                 Height="24"
                            />
                            
                            <Svg Path="/Assets/Icons/home-outline.svg" Css="{DynamicResource SvgIconCss}"
                                 Width="24"
                                 Height="24"/>
                            
                            <Svg Path="/Assets/Icons/settings-outline.svg"
                                 Width="24"
                                 Height="24"
                            />
                            <Svg Path="/Assets/Icons/file-text-outline.svg"
                                 Width="24"
                                 Height="24"
                            />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="1">
                        <Svg Path="/Assets/Icons/info-outline.svg"
                             Width="24"
                             Height="24"
                        />
                    </StackPanel>
                </Grid>
                
                <StackPanel Grid.Column="1" Margin="16" Spacing="16">
                    <!-- Working -->
                    <Border Classes="block">
                        <StackPanel Classes="block">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="heading-page">PC is available for management</TextBlock>
                                <TextBlock Classes="body-small">Send commands to your Telegram bot</TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        </ThemeVariantScope>
    </Design.PreviewWith>

    <!-- Text -->
    <!-- Headings -->
    <Style Selector="TextBlock.heading-page">
        <Setter Property="FontSize" Value="25"></Setter>
        <Setter Property="LineHeight" Value="31"></Setter>
        <Setter Property="FontWeight" Value="Bold"></Setter>
        <Setter Property="TextAlignment" Value="Left"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"></Setter>
    </Style>
    
    <Style Selector="TextBlock.heading-section">
        <Setter Property="FontSize" Value="20"></Setter>
        <Setter Property="LineHeight" Value="25"></Setter>
        <Setter Property="FontWeight" Value="Bold"></Setter>
        <Setter Property="TextAlignment" Value="Left"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>

    <!-- Body text -->
    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="16"></Setter>
        <Setter Property="LineHeight" Value="20"></Setter>
        <Setter Property="FontWeight" Value="Regular"></Setter>
        <Setter Property="TextAlignment" Value="Left"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>

    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="16"></Setter>
        <Setter Property="LineHeight" Value="20"></Setter>
        <Setter Property="FontWeight" Value="Medium"></Setter>
        <Setter Property="TextAlignment" Value="Left"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>

    <Style Selector="TextBlock.body-small">
        <Setter Property="FontSize" Value="13"></Setter>
        <Setter Property="LineHeight" Value="16"></Setter>
        <Setter Property="FontWeight" Value="Regular"></Setter>
        <Setter Property="TextAlignment" Value="Left"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"></Setter>
    </Style>

    <Style Selector="TextBlock.label-small">
        <Setter Property="FontSize" Value="16"></Setter>
        <Setter Property="LineHeight" Value="20"></Setter>
        <Setter Property="FontWeight" Value="Regular"></Setter>
        <Setter Property="TextAlignment" Value="Center"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="13"></Setter>
        <Setter Property="LineHeight" Value="16"></Setter>
        <Setter Property="FontWeight" Value="Regular"></Setter>
        <Setter Property="TextAlignment" Value="Left"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>

    <Style Selector="TextBlock.caption-xs">
        <Setter Property="FontSize" Value="10"></Setter>
        <Setter Property="LineHeight" Value="13"></Setter>
        <Setter Property="FontWeight" Value="Regular"></Setter>
        <Setter Property="TextAlignment" Value="Left"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>

    <Style Selector="TextBlock.pairing-value">
        <Setter Property="FontSize" Value="31"></Setter>
        <Setter Property="LineHeight" Value="39"></Setter>
        <Setter Property="FontWeight" Value="SemiBold"></Setter>
        <Setter Property="TextAlignment" Value="Left"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>
    
    <!-- Border -->
    <Style Selector="Border.block">
        <Setter Property="CornerRadius" Value="16"></Setter>
        <Setter Property="BorderThickness" Value="1"></Setter>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"></Setter>
        <Setter Property="Padding" Value="16"></Setter>
    </Style>
    
    <!-- Block -->
    <Style Selector="StackPanel.block">
        <Setter Property="Spacing" Value="24"></Setter>
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"></Setter>
    </Style>
    
    <!-- Icons -->
    <Style Selector="Svg">
        <Setter Property="(Svg.CurrentCss)"
                Value="{DynamicResource SvgIconCss}"/>
    </Style>

    <!-- Buttons -->
    <Style Selector="Button">
        <Setter Property="Height" Value="40"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontSize" Value="16"></Setter>
        <Setter Property="FontWeight" Value="Medium"></Setter>
        <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
        <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
        <Setter Property="Padding" Value="16 0"></Setter>
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonText}"/>
    </Style>

    <!-- Hover -->
    <Style Selector="Button.pointerover">
        
    </Style>

    <!-- Pressed -->
    <Style Selector="Button.pressed">
        
    </Style>

    <!-- Disabled -->
    <Style Selector="Button.disabled">
        <Setter Property="Opacity" Value="0.64"/>
    </Style>
    
    <!-- Active -->
    <Style Selector="Button.active">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"></Setter>
        <Setter Property="Background" Value="Transparent"></Setter>
        <Setter Property="BorderThickness" Value="1"></Setter>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"></Setter>
    </Style>

    <!-- Inputs -->
    <Style Selector="TextBox">
        <Setter Property="Padding" Value="12"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
    </Style>
    
</Styles>
